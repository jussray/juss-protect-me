{
  "name": "juss-protect-me",
  "main": "./worker.mjs",
  "compatibility_date": "2026-10-15",
  "vars": { "FOUNDER_EMAIL": "founder@jussco.company", "FOUNDER_SALT": "522f4db95eb15e6844c660932f51ccb6" },
  "kv_namespaces": [
    { "binding": "USERS_KV", "id": "e14225163c7c4fd4bb14bcc9e8f5f610" }
  ],
  "ratelimits": [
    {
      "name": "SHIELD_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
